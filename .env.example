# Claves de API — solo necesitas la del proveedor que vayas a usar.
# El proveedor se elige desde la UI (selector "Modelo").

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# DeepSeek (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# Kimi / Moonshot (https://platform.moonshot.ai/)
KIMI_API_KEY=

# Opcional: sobreescribir el modelo de cada proveedor
# ANTHROPIC_MODEL=claude-sonnet-4-6
# DEEPSEEK_MODEL=deepseek-chat
# KIMI_MODEL=kimi-k2-0905-preview
