---
import Layout from '../layouts/Layout.astro';
import ComponentCard from '../components/ComponentCard.astro';
import { listComponents, getComponentHtml } from '../lib/library';

const components = await listComponents();
const htmlBySlug = new Map<string, string>();
for (const c of components) {
  htmlBySlug.set(c.slug, (await getComponentHtml(c.slug)) ?? '');
}

const allTags = [...new Set(components.flatMap((c) => c.tags))].sort();
const allLibraries = [...new Set(components.flatMap((c) => c.libraries))].sort();
---
<Layout title="Dashboard">
  <div class="dashboard-header">
    <div>
      <h1>Biblioteca de componentes</h1>
      <p class="subtitle">{components.length} componente{components.length === 1 ? '' : 's'} guardado{components.length === 1 ? '' : 's'}</p>
    </div>
    <a class="btn btn-primary" href="/extract">+ Extraer componentes</a>
  </div>

  <div class="filters">
    <input type="text" id="search-input" placeholder="Buscar por nombre o descripción..." />
    <select id="tag-filter">
      <option value="">Todas las tags</option>
      {allTags.map((tag) => <option value={tag}>{tag}</option>)}
    </select>
    <select id="library-filter">
      <option value="">Todas las librerías</option>
      {allLibraries.map((lib) => <option value={lib}>{lib}</option>)}
    </select>
  </div>

  {components.length === 0 ? (
    <div class="empty-state card">
      <p>Aún no hay componentes guardados.</p>
      <a class="btn btn-primary" href="/extract">Extrae tu primer componente</a>
    </div>
  ) : (
    <div class="grid" id="components-grid">
      {components.map((meta) => (
        <ComponentCard meta={meta} html={htmlBySlug.get(meta.slug) ?? ''} />
      ))}
    </div>
  )}

  <div class="selection-bar" id="selection-bar">
    <span id="selection-count">0 seleccionados</span>
    <div class="selection-actions">
      <button class="btn" id="clear-selection">Limpiar</button>
      <button class="btn btn-primary" id="open-prompt-panel">Generar prompt</button>
    </div>
  </div>

  <div class="overlay" id="prompt-overlay">
    <div class="panel card">
      <div class="panel-header">
        <h2>Generar prompt maestro</h2>
        <button class="btn btn-small" id="close-prompt-panel">Cerrar</button>
      </div>
      <p class="panel-hint">Componentes seleccionados: <span id="panel-selection-list"></span></p>
      <label for="context-input">Contexto adicional (tipo de web, contenido, tono...)</label>
      <textarea id="context-input" rows="4" placeholder="Ej: Una landing page para un estudio de diseño, tono minimalista y elegante, en español..."></textarea>
      <label for="provider-select">Modelo</label>
      <select id="provider-select" class="provider-select">
        <option value="anthropic">Claude (Anthropic)</option>
        <option value="deepseek">DeepSeek</option>
        <option value="kimi">Kimi (Moonshot)</option>
      </select>
      <div class="panel-actions">
        <button class="btn btn-primary" id="generate-btn">Generar</button>
        <button class="btn" id="copy-btn" disabled>Copiar</button>
      </div>
      <pre class="prompt-output" id="prompt-output"></pre>
    </div>
  </div>
</Layout>

<style>
  .dashboard-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  h1 { margin: 0 0 0.25rem; font-size: 1.75rem; }
  .subtitle { margin: 0; color: var(--text-dim); font-size: 0.9rem; }

  .filters {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }
  .filters input { flex: 1; min-width: 220px; }
  .filters select {
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.25rem;
    padding-bottom: 6rem;
  }

  .empty-state {
    padding: 4rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    color: var(--text-dim);
  }

  .selection-bar {
    position: fixed;
    bottom: 1.5rem;
    left: 50%;
    transform: translate(-50%, 150%);
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    box-shadow: 0 10px 40px rgba(0,0,0,0.4);
    transition: transform 0.2s ease;
    z-index: 50;
  }
  .selection-bar.visible { transform: translate(-50%, 0); }
  .selection-actions { display: flex; gap: 0.5rem; }

  .overlay {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.6);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
    padding: 1.5rem;
  }
  .overlay.visible { display: flex; }

  .panel {
    width: 100%;
    max-width: 720px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .panel-header h2 { margin: 0; font-size: 1.25rem; }
  .panel-hint { margin: 0; font-size: 0.85rem; color: var(--text-dim); }
  .panel label { font-size: 0.85rem; color: var(--text-dim); }
  .panel-actions { display: flex; gap: 0.5rem; }
  .provider-select {
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    color: var(--text);
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    align-self: flex-start;
  }

  .prompt-output {
    white-space: pre-wrap;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 1rem;
    font-size: 0.8rem;
    line-height: 1.6;
    max-height: 40vh;
    overflow-y: auto;
    min-height: 4rem;
  }
</style>

<script>
  const grid = document.getElementById('components-grid');
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const tagFilter = document.getElementById('tag-filter') as HTMLSelectElement | null;
  const libraryFilter = document.getElementById('library-filter') as HTMLSelectElement | null;

  const selectionBar = document.getElementById('selection-bar')!;
  const selectionCount = document.getElementById('selection-count')!;
  const clearSelectionBtn = document.getElementById('clear-selection')!;
  const openPromptPanelBtn = document.getElementById('open-prompt-panel')!;
  const closePromptPanelBtn = document.getElementById('close-prompt-panel')!;
  const promptOverlay = document.getElementById('prompt-overlay')!;
  const panelSelectionList = document.getElementById('panel-selection-list')!;
  const generateBtn = document.getElementById('generate-btn') as HTMLButtonElement;
  const copyBtn = document.getElementById('copy-btn') as HTMLButtonElement;
  const promptOutput = document.getElementById('prompt-output')!;
  const contextInput = document.getElementById('context-input') as HTMLTextAreaElement;
  const providerSelect = document.getElementById('provider-select') as HTMLSelectElement;

  providerSelect.value = localStorage.getItem('llm-provider') || 'anthropic';
  providerSelect.addEventListener('change', () => {
    localStorage.setItem('llm-provider', providerSelect.value);
  });

  const selected = new Set<string>();

  function applyFilters() {
    if (!grid) return;
    const search = (searchInput?.value ?? '').trim().toLowerCase();
    const tag = tagFilter?.value ?? '';
    const lib = libraryFilter?.value ?? '';

    grid.querySelectorAll<HTMLElement>('.component-card').forEach((card) => {
      const name = card.dataset.name ?? '';
      const description = card.querySelector('.description')?.textContent?.toLowerCase() ?? '';
      const tags = (card.dataset.tags ?? '').split(',');
      const libs = (card.dataset.libraries ?? '').split(',');

      const matchesSearch = !search || name.includes(search) || description.includes(search);
      const matchesTag = !tag || tags.includes(tag);
      const matchesLib = !lib || libs.includes(lib);

      card.classList.toggle('is-hidden', !(matchesSearch && matchesTag && matchesLib));
    });
  }

  searchInput?.addEventListener('input', applyFilters);
  tagFilter?.addEventListener('change', applyFilters);
  libraryFilter?.addEventListener('change', applyFilters);

  function updateSelectionUI() {
    selectionCount.textContent = `${selected.size} seleccionado${selected.size === 1 ? '' : 's'}`;
    selectionBar.classList.toggle('visible', selected.size > 0);
    panelSelectionList.textContent = [...selected].join(', ') || '(ninguno)';
  }

  grid?.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('component-select')) return;
    const checkbox = target as HTMLInputElement;
    const slug = checkbox.dataset.slug!;
    const card = checkbox.closest('.component-card')!;
    if (checkbox.checked) {
      selected.add(slug);
      card.classList.add('is-selected');
    } else {
      selected.delete(slug);
      card.classList.remove('is-selected');
    }
    updateSelectionUI();
  });

  clearSelectionBtn.addEventListener('click', () => {
    selected.clear();
    grid?.querySelectorAll<HTMLInputElement>('.component-select').forEach((cb) => (cb.checked = false));
    grid?.querySelectorAll('.component-card').forEach((card) => card.classList.remove('is-selected'));
    updateSelectionUI();
  });

  openPromptPanelBtn.addEventListener('click', () => {
    updateSelectionUI();
    promptOutput.textContent = '';
    copyBtn.disabled = true;
    promptOverlay.classList.add('visible');
  });
  closePromptPanelBtn.addEventListener('click', () => promptOverlay.classList.remove('visible'));
  promptOverlay.addEventListener('click', (e) => {
    if (e.target === promptOverlay) promptOverlay.classList.remove('visible');
  });

  generateBtn.addEventListener('click', async () => {
    if (selected.size === 0) return;
    generateBtn.disabled = true;
    copyBtn.disabled = true;
    promptOutput.textContent = '';

    try {
      const res = await fetch('/api/generate-prompt', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slugs: [...selected], context: contextInput.value, provider: providerSelect.value }),
      });

      if (!res.ok || !res.body) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Error al generar el prompt.');
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      while (true) {
        const { done, value } = await reader.read();
        if (done) break;
        promptOutput.textContent += decoder.decode(value, { stream: true });
      }
      copyBtn.disabled = false;
    } catch (err) {
      promptOutput.textContent = `Error: ${err instanceof Error ? err.message : String(err)}`;
    } finally {
      generateBtn.disabled = false;
    }
  });

  copyBtn.addEventListener('click', async () => {
    await navigator.clipboard.writeText(promptOutput.textContent ?? '');
    copyBtn.textContent = 'Copiado ✓';
    setTimeout(() => (copyBtn.textContent = 'Copiar'), 1500);
  });

  grid?.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.classList.contains('delete-btn')) return;
    const slug = target.dataset.slug!;
    if (!confirm(`¿Borrar el componente "${slug}"? Esta acción no se puede deshacer.`)) return;

    target.setAttribute('disabled', 'true');
    const res = await fetch(`/api/components/${slug}`, { method: 'DELETE' });
    if (res.ok) {
      target.closest('.component-card')?.remove();
      selected.delete(slug);
      updateSelectionUI();
    } else {
      target.removeAttribute('disabled');
      alert('No se pudo borrar el componente.');
    }
  });
</script>
